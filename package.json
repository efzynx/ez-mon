{
  "name": "@ezmon/monorepo",
  "version": "0.1.19",

  "private": true,
  "description": "Lightweight self-hostable monitoring hub with push-based agents",
  "scripts": {
    "dev": "turbo dev --filter=@ezmon/web",
    "dev:cron": "node scripts/dev-cron.js",
    "evaluate": "node scripts/dev-cron.js once",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "pnpm --filter @ezmon/db db:studio"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "^2.9.10"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.39.3"
    }
  }
}
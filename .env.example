# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres / Supabase Connection URL
DATABASE_URL=postgresql://username:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── App Base URL ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create at: GitHub > Settings > Developer Settings > OAuth Apps
# Homepage URL: http://localhost:3000 (atau https://ezmon.web.id)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github (atau https://ezmon.web.id/api/auth/callback/github)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Email Service (Resend) ──────────────────────────────────────────────────
# Create at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="EZMON <noreply@ezmon.web.id>"

# ─── Evaluator / Cron Security ────────────────────────────────────────────────
# Shared secret token for Upstash QStash / Cron evaluator <-> Next.js API (/api/internal/evaluate)
CRON_SECRET=your-shared-cron-secret-token

# ─── Node.js Options ─────────────────────────────────────────────────────────
NODE_OPTIONS=--dns-result-order=ipv4first
